{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Server.Kestrel": "Debug",
      "Yarp": "Trace",
      "Yarp.ReverseProxy": "Trace"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "route-users" : {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Transforms": [{ "PathPattern": "{**catch-all}" }]
      },
      "route-accounts" : {
        "ClusterId": "accounts-cluster",
        "Match": {
          "Path": "/accounts/{**catch-all}"
        },
        "Transforms": [{ "PathPattern": "{**catch-all}" }]
      },
      "route-search" : {
        "ClusterId": "search-cluster",
        "Match": {
          "Path": "/search/{**catch-all}"
        },
        "Transforms": [{ "PathPattern": "{**catch-all}" }]
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "destination": {
            "Address": "http://users-service.default.svc.cluster.local:8080/api/users/"
          }
        }
      },
      "accounts-cluster": {
        "Destinations": {
          "destination": {
            "Address": "http://accounts-service.default.svc.cluster.local:8080/api/account/"
          }
        }
      },
      "search-cluster": {
        "Destinations": {
          "destination": {
            "Address": "http://search-service.default.svc.cluster.local:8080/api/search/"
          }
        }
      }
    }
  }
 }